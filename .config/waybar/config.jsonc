{
  "layer": "top",
  "position": "top",
  "spacing": 10,
  // "margin-top": 5,
  // "margin-left": 10,
  // "margin-right": 10,
  "reload_style_on_change": true,
  "modules-left": ["hyprland/workspaces", "hyprland/submap"],
  "modules-center": ["mpris"],
  "modules-right": [
    "tray",
    "custom/separator",
    "hyprland/language",
    "wireplumber",
    "temperature",
    "network",
    "clock"
  ],
  "backlight": {
    "format": "{icon} {percent}%"
  },
  "hyprland/language": {
    "format": "{}",
    "format-ru": "RU",
    "format-en": "EN"
  },
  "hyprland/workspaces": {
    "on-click": "activate",
    "format": "{icon}",
    "all-outputs": true,
    "sort-by-number": true,
    "format-icons": {
      "1": "一",
      "2": "二",
      "3": "三",
      "4": "四",
      "5": "五",
      "6": "六",
      "7": "七",
      "8": "八",
      "9": "九",
      "10": "十"
    }
  },
  "clock": {
    "format": "{:%a %e %b %H:%M}",
    "tooltip": false
  },
  "network": {
    "format-wifi": "",
    "format-ethernet": "",
    "format-disconnected": "",
    "tooltip-format-disconnected": "Error",
    "tooltip-format-wifi": "{essid} ({signalStrength}%)  ",
    "tooltip-format-ethernet": "{ifname} 🖧 ",
    "on-click": "nmtui"
  },
  "custom/separator": {
    "format": "|",
    "tooltip": false
  },
  "temperature": {
    "hwmon-path": "/sys/class/hwmon/hwmon0/temp3_input",
    "critical-threshold": 50,
    "format": "TEMP {temperatureC}°C",
    "format-critical": "TEMP {temperatureC}°C"
  },
  "tray": {
    "icon-size": 20,
    "spacing": 10,
    "show-passive-items": true
  },
  "wireplumber": {
    "format": "VOL {volume}%",
    "format-muted": "",
    "on-click": "pavucontrol",
    "format-icons": ["", "", ""]
  },
  "mpris": {
    "format": "󰐹 {title} - {artist}",
    "format-paused": " <i>{title}</i> - {artist}",
    "format-stopped": "STOPPED",
    "artist-len": 20,
    "title-len": 20
  },
  "memory": {
    "format": " {used:0.1f}G/{total:0.1f}G"
  },
  "cpu": {
    "format": " {usage}%"
  }
}
