include "binds.kdl"
include "layout.kdl"

spawn-at-startup "awww-daemon"
spawn-at-startup "waybar"

spawn-sh-at-startup "/home/striker/.chameleon/bin/chameleon-launcher -s ~/.config/chameleon/themes/material.css"

environment {
    XDG_SESSION_TYPE "wayland"

    QT_QPA_PLATFORM "wayland"
    QT_WAYLAND_DISABLE_WINDOWDECORATION "1"

    ELECTRON_OZONE_PLATFORM_HINT "wayland"
    GDK_BACKEND "wayland"
}

cursor {
    hide-when-typing
}

input {
    keyboard {
        xkb {
            layout "us,ru"
            options "caps:swapescape, grp:shifts_toggle"
        }
    }
    touchpad {
        tap
        natural-scroll
    }

    focus-follows-mouse max-scroll-amount="0%"
}

output "eDP-1" {
    mode "1920x1080@60"
    scale 1
    focus-at-startup
}

blur {
    off
    passes 3
}

hotkey-overlay {
    // Uncomment this line to disable the "Important Hotkeys" pop-up at startup.
    skip-at-startup
}

prefer-no-csd

screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

animations {
    workspace-switch {
        spring damping-ratio=1.2 stiffness=600 epsilon=0.0001
    }

    window-open {
        // duration-ms 200
        // curve "cubic-bezier" 0.25 0.1 0.25 1.0
        spring damping-ratio=1.2 stiffness=800 epsilon=0.0001
    }

    window-close {
        // duration-ms 300
        // curve "ease-out-cubic"
        spring damping-ratio=1.4 stiffness=600 epsilon=0.0001
    }

    horizontal-view-movement {
        // duration-ms 250
        // curve "ease-out-cubic"
        spring damping-ratio=1.2 stiffness=800 epsilon=0.0001
    }

    window-movement {
        spring damping-ratio=1.2 stiffness=600 epsilon=0.0001
    }

    config-notification-open-close {
        spring damping-ratio=0.6 stiffness=1000 epsilon=0.0001
    }

    exit-confirmation-open-close {
        spring damping-ratio=0.6 stiffness=500 epsilon=0.0001
    }

    screenshot-ui-open {
        duration-ms 200
        curve "ease-out-quad"
    }

    window-resize {
        spring damping-ratio=1.2 stiffness=600 epsilon=0.0001
    }

    overview-open-close {
        spring damping-ratio=1.0 stiffness=800 epsilon=0.0001
    }

    recent-windows-close {
        spring damping-ratio=1.4 stiffness=600 epsilon=0.0001
    }
}

// Open the Firefox picture-in-picture player as floating by default.
window-rule {
    match app-id="firefox$" title="^Picture-in-Picture$"
    open-floating true
}

